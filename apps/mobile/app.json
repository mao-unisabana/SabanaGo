{
  "expo": {
    "name": "Parqueo",
    "slug": "parqueo",
    "scheme": "parqueo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parqueo.app"
    },
    "android": {
      "package": "com.parqueo.app"
    },
    "web": {},
    "plugins": [
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación para centrar el mapa donde estás."
        }
      ]
    ]
  }
}
