# Supabase (local: valores que imprime `supabase start`; demo: proyecto en la nube)
# SUPABASE_URL + SUPABASE_ANON_KEY: las usa la app (con el token del usuario).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY: las usa la detección (services/detection). Nunca en la app ni en Git.
SUPABASE_SERVICE_ROLE_KEY=

# Detección (services/detection)
CAMERA_ID=1
VIDEO_SOURCE=data/videos/zona-piloto.mp4
DETECTOR=diff
CONFIDENCE_THRESHOLD=0.7
INGEST_INTERVAL_S=1.5
DIFF_THRESHOLD=25
# Vista de depuración en vivo (http://localhost:8000/preview). 1/true = encendida. Apagada por defecto.
# Los cuadros solo viven en memoria, nunca se escriben a disco.
PREVIEW=0
