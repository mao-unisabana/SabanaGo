# Supabase (local: valores que imprime `supabase start`; demo: proyecto en la nube)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Solo para services/detection. Nunca en la app ni en Git.
SUPABASE_SERVICE_ROLE_KEY=

# Detección (services/detection)
CAMERA_ID=1
VIDEO_SOURCE=data/videos/zona-piloto.mp4
DETECTOR=diff
CONFIDENCE_THRESHOLD=0.7
INGEST_INTERVAL_S=1.5
DIFF_THRESHOLD=25
